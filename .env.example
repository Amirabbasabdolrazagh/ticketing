# Issabel / Asterisk AMI (only on the application server; never expose these to the browser)
ISSABEL_AMI_HOST=192.168.3.5
ISSABEL_AMI_PORT=5038
ISSABEL_AMI_USERNAME=itrasam_app
ISSABEL_AMI_SECRET=replace-with-the-private-ami-password
ISSABEL_COMPANY_CALLER_ID=02186191205
# Prefix required by the Issabel outbound route before a customer number (for example: 9)
ISSABEL_OUTBOUND_PREFIX=9
# Used when a new ticket has not yet been assigned to or called by a support agent
ISSABEL_DEFAULT_SUPPORT_EXTENSION=102
ISSABEL_WEBRTC_CHANNEL_DRIVER=SIP

# Web phone (generate both secrets with: openssl rand -base64 32)
AUTH_COOKIE_DOMAIN=.itrasam.com
PHONE_CREDENTIAL_KEY=replace-with-a-base64-encoded-32-byte-key
PHONE_RECORDING_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
PHONE_RECORDING_PATH=/app/storage/call-recordings
ISSABEL_RECORDING_DIALPLAN_ENABLED=0
# Override only if the phone container uses host networking instead of the Compose bridge.
# PHONE_TRANSCRIPTION_FAST_URL=http://127.0.0.1:9001
NEXT_PUBLIC_PHONE_URL=https://phone.itrasam.com/phone
NEXT_PUBLIC_SUPPORT_URL=https://support.itrasam.com
PHONE_PUBLIC_WSS_URL=wss://phone.itrasam.com/sip-wss
PHONE_SIP_DOMAIN=phone.itrasam.com
# coturn REST authentication: only the server reads the 64-character secret.
# Set PHONE_TURN_EPHEMERAL_ENABLED=1 only after Coturn and the WireGuard
# RTP relay path are confirmed working. The secret must match Coturn's
# static-auth-secret in /etc/turnserver.conf. Never prefix with NEXT_PUBLIC_.
PHONE_TURN_EPHEMERAL_ENABLED=0
PHONE_TURN_URL=turn:turn.support.itrasam.com:3478?transport=udp
PHONE_TURN_AUTH_SECRET=
# Legacy static-credential provisioning (not used when ephemeral is enabled).
PHONE_TURN_USERNAME=
PHONE_TURN_SECRET=
PHONE_INBOUND_ROUTER_SECRET=replace-with-a-long-random-router-secret
# Call reports are extracted locally by the Shenava sidecar; no AI analysis API is used.
# Optional manual Google Speech-to-Text comparison. Audio is sent to a private GCS bucket
# only after a user clicks the Google button. Mount the service-account JSON read-only.
# GOOGLE_CLOUD_STT_BUCKET=private-itrasam-phone-stt
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/itrasam-google-stt.json
