{
  "$schema": "https://raw.githubusercontent.com/Ylianst/MeshCentral/master/meshcentral-config-schema.json",
  "settings": {
    "cert": "remote.itrasam.com",
    "WANonly": true,
    "port": 4430,
    "aliasPort": 443,
    "redirPort": 0,
    "tlsOffload": true,
    "agentPong": 300,
    "webRTC": true,
    "allowFraming": false
  },
  "domains": {
    "": {
      "title": "",
      "title2": "",
      "siteStyle": 3,
      "titlePicture": "title-itrasam.png",
      "loginPicture": "title-itrasam.png",
      "welcomeText": "پشتیبانی از راه دور، فقط با رضایت مشتری",
      "loginfooter": "<span dir='rtl'>اتصال ایمن و موقت با رضایت مشتری</span>",
      "footer": "<span dir='rtl'>سامانه پشتیبانی از راه دور آی تی رسام</span>",
      "customFiles": {
        "itrasam-login": {
          "css": ["itrasam-login.css"],
          "scope": ["login", "login2", "login-mobile"]
        },
        "itrasam-portal": {
          "css": ["itrasam-portal.css"],
          "js": ["itrasam-portal.js"],
          "scope": ["default", "default3", "default-mobile"]
        }
      },
      "newAccounts": false,
      "agentInviteCodes": true,
      "certUrl": "https://remote.itrasam.com/",
      "agentCustomization": {
        "displayName": "پشتیبانی آی تی رسام",
        "description": "عامل دسترسی از راه دور با رضایت مشتری",
        "companyName": "آی تی رسام",
        "serviceName": "ITRasamRemoteSupport",
        "installText": "این برنامه فقط برای پشتیبانی موقت و با رضایت شما استفاده می‌شود.",
        "fileName": "ITRasamSupport",
        "foregroundColor": "#0d6efd",
        "backgroundColor": "#0a2540"
      }
    }
  }
}
