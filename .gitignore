# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploaded ticket attachments
/storage/ticket-attachments/*
!/storage/ticket-attachments/.gitkeep

# MeshCentral keeps encryption keys, its local database and audit data here.
# Keep the versioned sample configuration only.
/remote-support/meshcentral-data/*
!/remote-support/meshcentral-data/config.json.example
!/remote-support/meshcentral-data/title-itrasam.png

# Private accounting documents (never commit uploaded files)
/storage/accounting-archive/
