[itrasam-inbound]
exten => s,1,NoOp(ITRASAM secure inbound routing)
 same => n,AGI(itrasam_inbound_router.py)
 same => n,Set(CALLERID(name)=${ITRASAM_CUSTOMER_NAME})
 same => n,GotoIf($["${ITRASAM_ROUTE_STATUS}"="matched"]?owner:fallback)
 same => n(owner),Set(ITRASAM_WAIT=0)
 same => n,Progress()
 same => n,Ringing()
 same => n(wait-owner),GotoIf($["${ITRASAM_WEB_ENDPOINT}"!=""]?ring-owner)
 same => n,GotoIf($[${ITRASAM_WAIT}>=25]?fallback)
 same => n,Wait(2)
 same => n,Set(ITRASAM_WAIT=$[${ITRASAM_WAIT}+1])
 same => n,AGI(itrasam_inbound_router.py)
 same => n,Goto(wait-owner)
 same => n(ring-owner),GotoIf($["${ITRASAM_RECORDING_ENABLED}"!="1"]?dial-owner)
 same => n,Set(ITRASAM_RECORDING=/var/spool/asterisk/monitor/itrasam-${ITRASAM_CALL_ID}.wav)
 same => n,MixMonitor(${ITRASAM_RECORDING},b,/var/lib/asterisk/agi-bin/itrasam_recording_upload.py ${ITRASAM_CALL_ID} ${ITRASAM_RECORDING})
 same => n(dial-owner),Dial(SIP/${ITRASAM_WEB_ENDPOINT}&SIP/${ITRASAM_EXTENSION},30,tT)
 same => n,StopMixMonitor()
 same => n,GotoIf($["${DIALSTATUS}"="ANSWER"]?completed:fallback)
 same => n(completed),AGI(itrasam_inbound_router.py,completed,${CDR(billsec)})
 same => n,Hangup()
 same => n(fallback),AGI(itrasam_inbound_router.py,missed)
 same => n,Goto(ivr-4,s,1)
exten => h,1,GotoIf($[${CDR(billsec)}>0]?completed)
 same => n,AGI(itrasam_inbound_router.py,missed)
 same => n,Goto(end)
 same => n(completed),AGI(itrasam_inbound_router.py,completed,${CDR(billsec)})
 same => n(end),NoOp(ITRASAM inbound call finished)

; مسیر خروجی را فقط پس از نصب این context با ISSABEL_RECORDING_DIALPLAN_ENABLED=1 فعال کنید.
[itrasam-outbound]
exten => _X.,1,NoOp(ITRASAM secure outbound recording)
 same => n,GotoIf($["${ITRASAM_CALL_ID}"=""]?invalid)
 same => n,GotoIf($["${ITRASAM_RECORDING_ENABLED}"!="1"]?dial-customer)
 same => n,Set(ITRASAM_RECORDING=/var/spool/asterisk/monitor/itrasam-${ITRASAM_CALL_ID}.wav)
 same => n,MixMonitor(${ITRASAM_RECORDING},b,/var/lib/asterisk/agi-bin/itrasam_recording_upload.py ${ITRASAM_CALL_ID} ${ITRASAM_RECORDING})
 same => n(dial-customer),Dial(Local/${EXTEN}@from-internal/n,60,tT)
 same => n,StopMixMonitor()
 same => n,Hangup()
 same => n(invalid),Hangup()

; مسیر ورودی DID شرکت در Issabel باید به context بالا هدایت شود.
; برای تماس دارای تیکت، تماس‌گیرنده حداکثر حدود ۵۰ ثانیه منتظر باز شدن و ثبت تلفن وب می‌ماند.
; تماس‌های ناشناس، بدون تیکت فعال، یا بی‌پاسخ به IVR فعلی (ivr-4) بازمی‌گردند.
