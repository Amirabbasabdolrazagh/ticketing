[itrasam-inbound]
exten => s,1,NoOp(ITRASAM secure inbound routing)
 same => n,AGI(itrasam_inbound_router.py)
 same => n,Set(CALLERID(name)=${ITRASAM_CUSTOMER_NAME})
 same => n,GotoIf($["${ITRASAM_ROUTE_STATUS}"="matched"]?owner:fallback)
 same => n(owner),GotoIf($["${ITRASAM_WEB_ENDPOINT}"=""]?owner-extension)
 same => n,Dial(SIP/${ITRASAM_WEB_ENDPOINT}&SIP/${ITRASAM_EXTENSION},30,tT)
 same => n,Goto(fallback)
 same => n(owner-extension),Dial(SIP/${ITRASAM_EXTENSION},30,tT)
 same => n,Goto(fallback)
 same => n(fallback),Goto(ivr-4,s,1)

; مسیر ورودی DID شرکت در Issabel باید به context بالا هدایت شود.
; تماس‌های ناشناس یا بدون تیکت فعال به IVR فعلی (ivr-4) بازمی‌گردند.
